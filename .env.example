# SuperClaude Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# =============================================================================
# SuperClaude API Keys (automatically loaded on package import)
# =============================================================================

# Morphllm API Key - Required for Morph LLM features
# Get your key from: https://morphllm.com
MORPH_API_KEY=your_morph_api_key_here

# Tavily API Key - Required for web search capabilities
# Get your key from: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# 21st.dev API Key - Required for UI component generation
# Get your key from: https://21st.dev
TWENTYFIRST_API_KEY=your_21st_api_key_here

# =============================================================================
# Development & Publishing
# =============================================================================

# PyPI API Tokens (for package publishing)
PYPI_API_TOKEN=pypi-your-production-token-here
TEST_PYPI_API_TOKEN=pypi-your-test-token-here

# =============================================================================
# Optional Configuration
# =============================================================================

# Debug Mode - Enable verbose logging for .env loading and troubleshooting
# Values: true, false
# SUPERCLAUDE_DEBUG=false

# =============================================================================
# Platform-Specific Notes
# =============================================================================

# Windows Users:
# - Environment variables are automatically loaded from this file
# - Supports drive letters (C:\, D:\), UNC paths (\\server\share)
# - Variable names are case-sensitive in Python (use exact case)
# - Use backslashes or forward slashes for paths (both work)

# Linux/macOS Users:
# - Environment variables are automatically loaded from this file
# - Use forward slashes for paths: /path/to/file
# - Variable names are case-sensitive

# =============================================================================
# Security Best Practices
# =============================================================================

# 1. Never commit .env file to version control (already in .gitignore)
# 2. Keep API keys secret and rotate them periodically
# 3. On Unix systems, set restrictive permissions: chmod 600 .env
# 4. Use separate .env files for development and production
# 5. Use environment-specific prefixes if needed (DEV_, PROD_, etc.)

# =============================================================================
# GitHub Secrets (for CI/CD)
# =============================================================================

# Add these to your GitHub repository settings:
# Settings → Secrets and variables → Actions
# - PYPI_API_TOKEN=pypi-your-production-token-here
# - TEST_PYPI_API_TOKEN=pypi-your-test-token-here
# - MORPH_API_KEY=your_morph_api_key_here
# - TAVILY_API_KEY=your_tavily_api_key_here
# - TWENTYFIRST_API_KEY=your_21st_api_key_here

# =============================================================================
# Usage
# =============================================================================

# Environment variables are automatically loaded when you import SuperClaude:
#
#   import superclaude
#   import os
#   api_key = os.getenv("MORPH_API_KEY")
#
# Or use SuperClaude's utility functions:
#
#   from superclaude.env import get_env, require_env, is_env_set
#
#   # Get with default value
#   api_key = get_env("MORPH_API_KEY", "default_key")
#
#   # Require (raises error if not set)
#   api_key = require_env("MORPH_API_KEY")
#
#   # Check if set
#   if is_env_set("MORPH_API_KEY"):
#       print("API key is configured")
#
# For more information, see: docs/environment-management.md
